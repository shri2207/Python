def make_contacts(n):
    return [
        {"name": f"Person {i}",
         "phones": [f"{9000000000 + i:010d}"],
         "emails": [f"person{i}@example.com"]}
        for i in range(n)
    ]
 
for n in (1_000, 100_000):
    data = make_contacts(n)
    t0 = perf_counter()
    merged, review = merge_contacts([data])
    elapsed = perf_counter() - t0
    print(n, "contacts:", elapsed, "seconds; merged:", len(merged))

