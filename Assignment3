import re
from time import perf_counter
 
def normalise_phone(value):
    digits = re.sub(r"\D", "", value or "")
    if not digits:
        return ""
    if len(digits) == 10:
        return "+91" + digits
    if len(digits) == 12 and digits.startswith("91"):
        return "+" + digits
    return "+" + digits
 
def normalise_email(value):
    return (value or "").strip().lower()
 
def normalise_name(value):
    return " ".join((value or "").lower().split())
 
def merge_contacts(contact_sources):
    merged = {}
    manual_review = []
 
    for source in contact_sources:
        for contact in source:
            raw_phones = contact.get("phones", [])
            raw_emails = contact.get("emails", [])
            phones = {normalise_phone(p) for p in raw_phones}
            phones.discard("")
            emails = {normalise_email(e) for e in raw_emails}
            emails.discard("")
 
            # Prefer a phone key; use email only if no phone is present.
            key = sorted(phones)[0] if phones else (
                "email:" + sorted(emails)[0] if emails else ""
            )
            if not key:
                manual_review.append(contact)
                continue
 
            if key not in merged:
                merged[key] = {
                    "name": contact.get("name", "").strip(),
                    "phones": set(),
                    "emails": set()
                }
            merged[key]["phones"].update(phones)
            merged[key]["emails"].update(emails)
 
            if not merged[key]["name"] and contact.get("name"):
                merged[key]["name"] = contact["name"].strip()
 
    return merged, manual_review
 
