import time

# Original recursive program
def original(n):
    if n <= 1:
        return 1
    return original(n - 1) + original(n - 2)


# Redesigned iterative program
def redesigned(n):
    a = 1
    b = 1

    for i in range(2, n + 1):
        a, b = b, a + b

    return b


for n in [10, 20, 25, 30]:
    start = time.perf_counter()
    old = original(n)
    old_time = time.perf_counter() - start

    start = time.perf_counter()
    new = redesigned(n)
    new_time = time.perf_counter() - start

    print("\nSteps:", n)
    print("Original:", old)
    print("Redesigned:", new)
    print("Same result:", old == new)
    print("Original time:", old_time)
    print("Redesigned time:", new_time)

print("\n1000 steps:")
print(redesigned(1000))

